# Supabase -> Project Settings -> API (use the project URL and the anon / publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Server only (never prefix with NEXT_PUBLIC_). Lets the login guard keep its failure counters in the database
# so they are shared by every server instance. Project Settings -> API -> service_role key. Without it, login
# attempts are only limited per server instance.
SUPABASE_SERVICE_ROLE_KEY=
